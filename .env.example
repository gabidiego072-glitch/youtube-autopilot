# Copy to .env for local development. Never commit .env.
# In the cloud, set these as environment variables / secrets instead.

# --- Application ---
ENVIRONMENT=development          # development | test | staging | production
DEBUG=false
LOG_LEVEL=INFO
API_PREFIX=/api/v1
# JSON list, e.g. ["https://dashboard.example.com"]
CORS_ORIGINS=[]
# Shared secret for the dashboard API (header X-API-Key). Required in production.
API_KEY=

# --- Database (PostgreSQL / Supabase) ---
# Supabase: Project Settings -> Database -> Connection string (use the
# "postgresql+psycopg://" scheme). Local dev may use sqlite:///./autopilot.db
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres
DATABASE_ECHO=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5

# --- Claude (Anthropic) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium             # low | medium | high | xhigh | max
CLAUDE_MAX_TOKENS=16000
CLAUDE_SERVER_FALLBACKS=true     # retry refused requests on a fallback model server-side
CLAUDE_TIMEOUT_SECONDS=600

# --- Research (free) ---
RESEARCH_ENABLED=true
WIKIPEDIA_LANGUAGE=es
# Wikimedia requires a descriptive agent with contact details.
WIKIPEDIA_USER_AGENT="YouTubeAutopilot/0.2 (you@example.com)"

# --- AI images / video (all optional; nothing is called unless configured) ---
# A) Self-hosted ComfyUI with open models (free with your own GPU / Colab / Kaggle)
COMFYUI_URL=
COMFYUI_IMAGE_WORKFLOW=          # path to an API-format workflow JSON with {{prompt}} etc.
COMFYUI_VIDEO_WORKFLOW=          # image-to-video workflow (Wan 2.x, LTX-Video...)
# B) Hugging Face Inference (free monthly credits)
HF_TOKEN=
HF_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell
HF_INFERENCE_URL=https://router.huggingface.co/hf-inference/models
VISUALS_TIMEOUT_SECONDS=300

# --- Voice (free, offline): pip install piper-tts && scripts/install_voice.sh ---
PIPER_BINARY=piper
PIPER_VOICE_MODEL=models/voices/es_ES-davefx-medium.onnx
PIPER_LENGTH_SCALE=0.92

# --- YouTube Data API v3 / YouTube Analytics API (OAuth 2.0) ---
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
# Safety switch: uploads are refused while false.
YOUTUBE_PUBLISHING_ENABLED=false

# --- Rendering ---
# Blender 4.5 LTS for the 3D engines (scripts/install_blender.sh installs it)
BLENDER_BINARY=blender
BLENDER_TIMEOUT_SECONDS=14400
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe
MEDIA_ROOT=./media
EDIT_RESOLUTION_SCALE=1.0        # e.g. 0.5 for faster preview edits
SHORTS_MAX_DURATION_SECONDS=180
LONG_FORM_MIN_DURATION_SECONDS=181
