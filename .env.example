# Copy to .env for local development. Never commit .env.
# In the cloud, set these as environment variables / secrets instead.

# --- Application ---
ENVIRONMENT=development          # development | test | staging | production
DEBUG=false
LOG_LEVEL=INFO
API_PREFIX=/api/v1
# JSON list, e.g. ["https://dashboard.example.com"]
CORS_ORIGINS=[]
# Shared secret for the dashboard API (header X-API-Key). Required in production.
API_KEY=

# --- Database (PostgreSQL / Supabase) ---
# Supabase: Project Settings -> Database -> Connection string (use the
# "postgresql+psycopg://" scheme). Local dev may use sqlite:///./autopilot.db
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres
DATABASE_ECHO=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5

# --- Claude (Anthropic) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium             # low | medium | high | xhigh | max
CLAUDE_MAX_TOKENS=16000
CLAUDE_SERVER_FALLBACKS=true     # retry refused requests on a fallback model server-side
CLAUDE_TIMEOUT_SECONDS=600

# --- YouTube Data API v3 / YouTube Analytics API (OAuth 2.0) ---
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
# Safety switch: uploads are refused while false.
YOUTUBE_PUBLISHING_ENABLED=false

# --- Rendering ---
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe
MEDIA_ROOT=./media
SHORTS_MAX_DURATION_SECONDS=180
LONG_FORM_MIN_DURATION_SECONDS=181
