    },
    "scenes": [
      {
        "beat": "hook",
        "narration": "¿Y si la Tierra frenara en seco?",
        "visual": "A busy street; everything lurches east as the ground stops",
        "scale": "street",
        "duration_seconds": 3.0,
        "claims": []
      },
      {
        "beat": "setup",
        "narration": "Ahora mismo, en España, tu calle gira con la Tierra a unos mil trescientos kilómetros por hora. Y no lo notas.",
        "subtitle": "Ahora mismo, en España, tu calle gira con la Tierra a unos 1.300 km/h. Y no lo notas.",
        "visual": "A calm street with people walking; a glowing arrow points east labelled 1.300 km/h",
        "scale": "street",
        "duration_seconds": 6.5,
        "claims": [
          {
            "text": "A la latitud de España (unos 40°) la superficie gira a unos 1.670 × cos 40° ≈ 1.280 km/h",
            "type": "established",
            "source": "https://es.wikipedia.org/wiki/Rotaci%C3%B3n_de_la_Tierra"
          }
        ]
      },
      {
        "beat": "escalation",
        "narration": "Si frenara de golpe, tú no te pararías: coches, bancos, cristales y personas saldrían despedidos hacia el este.",
        "visual": "Street: the ground stops, cars, benches and bins slide east, the hero building's windows shatter, a pedestrian is thrown",
        "scale": "street",
        "human_subject": "peatones y conductores",
        "consequence": "lanzados hacia el este junto con todo lo que no está anclado",
        "duration_seconds": 6.5,
        "claims": [
          {
            "text": "Por inercia, lo que no esté anclado al suelo seguiría moviéndose hacia el este a la velocidad de rotación",
            "type": "established",
            "source": "https://es.wikipedia.org/wiki/Inercia"
          }
        ]
      },
      {
        "beat": "escalation",
        "narration": "En casa, igual: muebles, libros y todo lo que no esté atornillado chocaría contra la pared del este.",
        "visual": "Living room: sofa, chairs and books slide into the east wall; the person falls",
        "scale": "interior",
        "human_subject": "una persona en su salón",
        "consequence": "muebles y objetos lanzados contra la pared",
        "duration_seconds": 5.5,
        "claims": [
          {
            "text": "Los objetos sueltos dentro de un edificio conservarían su velocidad mientras el edificio se detiene con el suelo",
            "type": "established",
            "source": "https://es.wikipedia.org/wiki/Inercia"
          }
        ]
      },
      {
        "beat": "escalation",
        "narration": "Y el aire tampoco frenaría: vientos de más de mil kilómetros por hora barrerían calles y edificios.",
        "subtitle": "Y el aire tampoco frenaría: vientos de más de 1.000 km/h barrerían calles y edificios.",
        "visual": "Street: violent wind streaks and debris race east between the buildings",
        "scale": "building",
        "human_subject": "edificios y calles",
        "consequence": "vientos más rápidos que cualquier huracán",
        "duration_seconds": 6.0,
        "claims": [
          {
            "text": "La atmósfera seguiría moviéndose a la velocidad de rotación, cerca de la velocidad del sonido (unos 1.235 km/h) en latitudes medias",
            "type": "established",
            "source": "https://es.wikipedia.org/wiki/Velocidad_del_sonido"
          }
        ]
      },
      {
        "beat": "climax",
        "narration": "Los océanos seguirían avanzando: el mar se lanzaría sobre las ciudades de la costa.",
        "visual": "Seafront: the sea rises over the promenade and floods the street while a person runs inland",
        "scale": "street",
        "human_subject": "vecinos de una ciudad costera",
        "consequence": "el mar inunda las calles",
        "duration_seconds": 5.5,
        "claims": [
          {
            "text": "El agua de los océanos también conservaría su movimiento hacia el este y anegaría las costas",
            "type": "estimate",
            "source": ""
          }
        ]
      },
      {
        "beat": "setup",
        "narration": "Si frenara muy poco a poco, durante miles de años, nadie saldría volando. Pero un día duraría un año entero.",
        "visual": "The same street in time-lapse: the sun crosses the sky slowly and sets",
        "scale": "street",
        "duration_seconds": 6.5,
        "claims": [
          {
            "text": "Sin rotación propia, el Sol solo daría una vuelta aparente al cielo por cada órbita: un día de un año",
            "type": "established",
            "source": "https://es.wikipedia.org/wiki/Rotaci%C3%B3n_de_la_Tierra"
          }
        ]
      },
      {
        "beat": "ending",
        "narration": "Seis meses de sol y seis meses de noche. ¿Tú en qué lado vivirías?",
        "visual": "Night street: lamps and windows switch on, people stand looking up",
        "scale": "street",
        "duration_seconds": 5.0,
        "claims": []
      }
    ]
  },
