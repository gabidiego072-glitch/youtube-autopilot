  "script": {
    "title_question": "¿Qué pasaría si la Tierra frenara en seco?",
    "hook": "¿Y si la Tierra frenara en seco?",
    "ending_type": "question",
    "ending_line": "¿Tú en qué lado vivirías?",
    "visual_bible": {
      "look": "procedural 3D, stylised European street, home and seafront",
